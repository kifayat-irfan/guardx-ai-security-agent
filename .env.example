# =====================================================================
# GuardX — environment configuration template
# Copy to .env and fill in ONLY the values for the providers you use.
# Never commit a real .env with secrets to git.
# =====================================================================

# ---- App ----
APP_ENV=dev
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# ---- Database (PostgreSQL) ----
POSTGRES_USER=guardx
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=guardx
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://guardx:change_me_in_production@postgres:5432/guardx

# ---- Computer Vision (Ultralytics YOLO) ----
YOLO_MODEL=yolov8n.pt          # pretrained nano model; no custom training in MVP
YOLO_CONFIDENCE=0.5
YOLO_IMGSZ=640
FRAME_SKIP=2                  # process every Nth frame (CPU-friendly)

# ---- Zone engine ----
DEFAULT_DWELL_SECONDS=2.0     # person must stay inside zone this long to fire
DEFAULT_COOLDOWN_SECONDS=60   # min seconds before the same zone fires again

# ---- LLM provider (pick ONE; set only its key) ----
LLM_PROVIDER=sensenova         # sensenova | openai | anthropic | google | ollama
LLM_MODEL=sensenova-6.8-flash-lite
LLM_TEMPERATURE=0.2
SENSENOVA_API_KEY=
SENSENOVA_MODEL=sensenova-6.8-flash-lite
SENSENOVA_BASE_URL=https://token.sensenova.ai/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://localhost:11434

# ---- Embeddings ----
EMBEDDING_PROVIDER=sentence-transformers   # sentence-transformers | openai
EMBEDDING_MODEL=all-MiniLM-L6-v2           # local, free, no key needed
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- ChromaDB (RAG vector store) ----
CHROMA_MODE=server            # server | embedded
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=guardx_policies
CHROMA_PERSIST_DIR=/app/data/chroma   # used when CHROMA_MODE=embedded

# ---- n8n automation (optional) ----
N8N_ENABLED=false
N8N_WEBHOOK_URL=http://n8n:5678/webhook/guardx-incident

# ---- Storage ----
ASSETS_DIR=/app/assets
SNAPSHOT_DIR=/app/assets/snapshots
SAMPLE_VIDEOS_DIR=/app/assets/sample_videos
